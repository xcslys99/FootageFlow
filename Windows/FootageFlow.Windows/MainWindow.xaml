<Window x:Class="FootageFlow.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:FootageFlow.Windows.Models"
        xmlns:infrastructure="clr-namespace:FootageFlow.Windows.Infrastructure"
        xmlns:controls="clr-namespace:FootageFlow.Windows.Controls"
        Title="FootageFlow" Width="1380" Height="880" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#FAFBFC"
        Icon="Assets/FootageFlow.png" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#1677E8" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#F3F5F8" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#667085" />
    <Style x:Key="KeyboardFocusVisual">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                    CornerRadius="4" Margin="-2" SnapsToDevicePixels="True" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
    </Style>
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <infrastructure:LicenseDisplayConverter x:Key="LicenseDisplay" />
    <infrastructure:ProviderNameConverter x:Key="ProviderName" />
    <infrastructure:ObjectVisibilityConverter x:Key="ObjectVisibility" />
    <infrastructure:ClipScopeVisibilityConverter x:Key="ClipScopeVisibility" />
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Margin" Value="10,2" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <DataTemplate x:Key="AssetCard" DataType="{x:Type models:MediaAsset}">
      <Border Width="292" Margin="7" Background="White" BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="9">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="164" /><RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Background="#E9EDF2" CornerRadius="8,8,0,0" ClipToBounds="True">
            <controls:RemoteThumbnail
              SourceURL="{Binding ThumbnailURL}" CandidateURLs="{Binding EffectiveThumbnailURLs}"
              FailureText="{Binding DataContext.ThumbnailUnavailableText, RelativeSource={RelativeSource AncestorType=Window}}"
              RetryText="{Binding DataContext.RetryThumbnailText, RelativeSource={RelativeSource AncestorType=Window}}" />
          </Border>
          <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="10" Width="24" Height="24" ToolTip="{Binding DataContext.SelectAllVisibleText, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding Title}" />
          <StackPanel Grid.Row="1" Margin="12">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" MaxHeight="42" />
            <TextBlock Margin="0,7,0,0" Foreground="{StaticResource SubtleTextBrush}">
              <Run Text="{Binding SourceDisplayName}" /><Run Text="  ·  " /><Run Text="{Binding Resolution}" /><Run Text="  ·  " /><Run Text="{Binding DurationText}" />
            </TextBlock>
            <TextBlock Text="{Binding Creator}" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
            <TextBlock Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,8">
              <TextBlock.Text><MultiBinding Converter="{StaticResource LicenseDisplay}"><Binding Path="License" /><Binding Path="LicenseStatus" /><Binding Path="DataContext.LicenseSafeText" RelativeSource="{RelativeSource AncestorType=Window}" /><Binding Path="DataContext.LicenseAttributionText" RelativeSource="{RelativeSource AncestorType=Window}" /><Binding Path="DataContext.LicensePublicDomainText" RelativeSource="{RelativeSource AncestorType=Window}" /><Binding Path="DataContext.LicenseRestrictedText" RelativeSource="{RelativeSource AncestorType=Window}" /><Binding Path="DataContext.LicenseUnknownText" RelativeSource="{RelativeSource AncestorType=Window}" /></MultiBinding></TextBlock.Text>
            </TextBlock>
            <WrapPanel>
              <Button Content="{Binding DataContext.PreviewText, RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding DataContext.PreviewText, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Button Content="♡" ToolTip="{Binding DataContext.FavoriteText, RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.FavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding DataContext.FavoriteText, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Button Content="{Binding DataContext.DownloadText, RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" IsEnabled="{Binding Downloadable}" AutomationProperties.Name="{Binding DataContext.DownloadText, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Button Content="MP4" ToolTip="{Binding DataContext.EditingCompatibleOutputText, RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.DownloadEditingCompatibleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding SupportsEditingOutput, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{Binding DataContext.EditingCompatibleOutputText, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Button Content="♫" ToolTip="{Binding DataContext.AudioOnlyOutputText, RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.DownloadAudioOnlyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding SupportsEditingOutput, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{Binding DataContext.AudioOnlyOutputText, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Button Content="{Binding DataContext.OpenSourceText, RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
              <Button Content="{Binding DataContext.CopySourceText, RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.CopySourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
              <Button Content="{Binding DataContext.CopyAttributionText, RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.CopyAttributionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="White" BorderBrush="#E2E6EB" BorderThickness="0,0,0,1">
      <Grid Margin="18,0">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="Assets/FootageFlow.png" Width="38" Height="38" Margin="0,0,10,0" />
          <TextBlock Text="FootageFlow" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" Content="{Binding WorkspaceGlobalSearchText}" Command="{Binding ShowGlobalSearchCommand}" ToolTip="Ctrl+Shift+G" AutomationProperties.Name="{Binding WorkspaceGlobalSearchText}" />
        <Button Grid.Column="2" x:Name="LanguageButton" Content="{Binding LanguageButton}" Click="LanguageButton_Click" FontWeight="SemiBold" MinWidth="132" AutomationProperties.Name="{Binding LanguageButton}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="226" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Background="{StaticResource SidebarBrush}" BorderBrush="#E2E6EB" BorderThickness="0,0,1,0" AutomationProperties.Name="{Binding DataContext.AccessibilityNavigationText, RelativeSource={RelativeSource AncestorType=Window}}">
        <StackPanel Margin="0,12" KeyboardNavigation.TabNavigation="Continue">
          <Button Style="{StaticResource NavButton}" Content="{Binding NavWorkspace}" Command="{Binding NavigateCommand}" CommandParameter="workspace" AutomationProperties.Name="{Binding NavWorkspace}" />
          <Button Style="{StaticResource NavButton}" Content="{Binding NavSearch}" Command="{Binding NavigateCommand}" CommandParameter="search" />
          <Button Style="{StaticResource NavButton}" Content="{Binding NavLinkDownloader}" Command="{Binding NavigateCommand}" CommandParameter="linkDownloader" />
          <Button Style="{StaticResource NavButton}" Content="{Binding NavScript}" Command="{Binding NavigateCommand}" CommandParameter="script" />
          <Button Style="{StaticResource NavButton}" Content="{Binding NavProjects}" Command="{Binding NavigateCommand}" CommandParameter="projects" />
          <Button Style="{StaticResource NavButton}" Content="{Binding NavFavorites}" Command="{Binding NavigateCommand}" CommandParameter="favorites" />
          <Button Style="{StaticResource NavButton}" Content="{Binding NavDownloads}" Command="{Binding NavigateCommand}" CommandParameter="downloads" />
          <Button Style="{StaticResource NavButton}" Content="{Binding NavHistory}" Command="{Binding NavigateCommand}" CommandParameter="history" />
          <Button Style="{StaticResource NavButton}" Content="{Binding NavFeedback}" Command="{Binding NavigateCommand}" CommandParameter="feedback" />
          <Separator Margin="14,10" />
          <Button Style="{StaticResource NavButton}" Content="{Binding NavSettings}" Command="{Binding NavigateCommand}" CommandParameter="settings" />
        </StackPanel>
      </Border>

      <Grid Grid.Column="1" Margin="24">
        <Grid Visibility="{Binding IsWorkspacePage, Converter={StaticResource BoolVisibility}}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <WrapPanel Margin="0,0,0,14">
                <StackPanel Width="620"><TextBlock Text="{Binding WorkspaceTitle}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding WorkspaceTagline}" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" /></StackPanel>
                <Button Content="{Binding WorkspaceGlobalSearchText}" Command="{Binding ShowGlobalSearchCommand}" ToolTip="Ctrl+Shift+G" AutomationProperties.Name="{Binding WorkspaceGlobalSearchText}" />
                <Button Content="{Binding WorkspaceCommandPaletteText}" Command="{Binding ShowCommandPaletteCommand}" ToolTip="Ctrl+K" />
              </WrapPanel>
              <WrapPanel Margin="0,0,0,18">
                <Border Background="White" BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,12" Width="180"><StackPanel><TextBlock Text="{Binding WorkspaceProjectCount}" FontSize="28" FontWeight="Bold" /><TextBlock Text="{Binding NavProjects}" Foreground="{StaticResource SubtleTextBrush}" /></StackPanel></Border>
                <Border Background="White" BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,12" Width="180"><StackPanel><TextBlock Text="{Binding WorkspaceFavoriteCount}" FontSize="28" FontWeight="Bold" /><TextBlock Text="{Binding NavFavorites}" Foreground="{StaticResource SubtleTextBrush}" /></StackPanel></Border>
                <Border Background="White" BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,12" Width="180"><StackPanel><TextBlock Text="{Binding WorkspaceDownloadCount}" FontSize="28" FontWeight="Bold" /><TextBlock Text="{Binding NavDownloads}" Foreground="{StaticResource SubtleTextBrush}" /></StackPanel></Border>
                <Border Background="White" BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,12" Width="200"><StackPanel><TextBlock Text="{Binding WorkspaceUnknownRightsCount}" FontSize="28" FontWeight="Bold" /><TextBlock Text="{Binding WorkspaceProviderHealthText}" Foreground="{StaticResource SubtleTextBrush}" /></StackPanel></Border>
              </WrapPanel>
              <TextBlock Text="{Binding WorkspaceSmartCollectionsText}" Style="{StaticResource SectionTitle}" />
              <ItemsControl ItemsSource="{Binding WorkspaceSmartCollections}" Margin="0,0,0,18">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate><Button Width="210" MinHeight="92" Command="{Binding DataContext.OpenSmartCollectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalContentAlignment="Left" AutomationProperties.Name="{Binding Title}"><StackPanel><TextBlock Text="{Binding Count}" FontSize="25" FontWeight="Bold" /><TextBlock Text="{Binding Title}" TextWrapping="Wrap" /></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding WorkspaceSavedSearchesText}" Style="{StaticResource SectionTitle}" />
              <ItemsControl ItemsSource="{Binding SavedSearches}">
                <ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding DataContext.WorkspaceSavedSearchesText, RelativeSource={RelativeSource AncestorType=Window}}" /><TextBlock Grid.Column="1" Text="{Binding Query}" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" Margin="12,0" TextTrimming="CharacterEllipsis" /><WrapPanel Grid.Column="2"><Button Content="{Binding DataContext.WorkspaceRunText, RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.RunSavedSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /><Button Content="{Binding DataContext.WorkspaceRenameText, RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.RenameSavedSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /><Button Content="{Binding DataContext.WorkspaceDuplicateText, RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.DuplicateSavedSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /><Button Content="×" Command="{Binding DataContext.DeleteSavedSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding DataContext.DeleteText, RelativeSource={RelativeSource AncestorType=Window}}" /></WrapPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid Margin="0,18,0,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding WorkspaceProviderHealthText}" Style="{StaticResource SectionTitle}" /><Button Grid.Column="1" Content="{Binding WorkspaceTestAllText}" Command="{Binding TestAllWorkspaceProvidersCommand}" AutomationProperties.Name="{Binding WorkspaceTestAllText}" /></Grid>
              <ItemsControl ItemsSource="{Binding Providers}">
                <ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" /><Button Grid.Column="2" Content="{Binding DataContext.WorkspaceTestText, RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.TestWorkspaceProviderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding WorkspaceShortcutsText}" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" />
              <ItemsControl ItemsSource="{Binding WorkspaceShortcutReference}">
                <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" /><TextBlock Grid.Column="1" Text="{Binding Shortcut}" FontFamily="Consolas" Foreground="{StaticResource SubtleTextBrush}" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <Grid Visibility="{Binding IsSearchPage, Converter={StaticResource BoolVisibility}}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding NavSearch}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding SearchTagline}" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,12" />
            <WrapPanel>
              <TextBlock Text="{Binding SearchScopeTitle}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox SelectedValue="{Binding SearchScope}" SelectedValuePath="Tag" Width="220" AutomationProperties.Name="{Binding SearchScopeTitle}">
                <ComboBoxItem Content="{Binding DataContext.SearchScopeMediaText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="media" />
                <ComboBoxItem Content="{Binding DataContext.SearchScopeResearchText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="research" />
                <ComboBoxItem Content="{Binding DataContext.SearchScopeAllText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="all" />
              </ComboBox>
            </WrapPanel>
          </StackPanel>
          <StackPanel Grid.Row="1">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBox x:Name="SearchQueryTextBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="17" MinHeight="46" ToolTip="{Binding SearchPlaceholder}" AutomationProperties.Name="{Binding SearchPlaceholder}" PreviewKeyDown="SearchQueryTextBox_PreviewKeyDown" />
              <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{Binding SearchButtonText}" Command="{Binding SearchCommand}" MinWidth="132" />
              <Button Grid.Column="2" Content="{Binding StopText}" Command="{Binding StopSearchCommand}" />
              <CheckBox Grid.Column="3" Content="{Binding DownloadableOnlyText}" IsChecked="{Binding DownloadableOnly}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
            </Grid>
            <TextBlock Text="{Binding SearchApiRecommendation}" Foreground="{StaticResource SubtleTextBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="2,7,0,0" />
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="0,12,0,6">
            <WrapPanel>
              <TextBlock Text="{Binding TypeTitle}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <ComboBox SelectedValue="{Binding MediaType}" SelectedValuePath="Tag" Width="110" AutomationProperties.Name="{Binding TypeTitle}">
                <ComboBoxItem Content="{Binding DataContext.VideoText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="video" /><ComboBoxItem Content="{Binding DataContext.ImageText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="image" /><ComboBoxItem Content="{Binding DataContext.AudioText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="audio" /><ComboBoxItem Content="{Binding DataContext.AllText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="all" />
              </ComboBox>
              <TextBlock Text="{Binding OrientationTitle}" VerticalAlignment="Center" Margin="15,0,6,0" />
              <ComboBox SelectedValue="{Binding Orientation}" SelectedValuePath="Tag" Width="125" AutomationProperties.Name="{Binding OrientationTitle}">
                <ComboBoxItem Content="{Binding DataContext.AllText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="all" /><ComboBoxItem Content="{Binding DataContext.LandscapeText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="landscape" /><ComboBoxItem Content="{Binding DataContext.PortraitText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="portrait" /><ComboBoxItem Content="{Binding DataContext.SquareText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="square" />
              </ComboBox>
              <TextBlock Text="{Binding ResolutionTitle}" VerticalAlignment="Center" Margin="15,0,6,0" />
              <ComboBox SelectedValue="{Binding Resolution}" SelectedValuePath="Tag" Width="110" AutomationProperties.Name="{Binding ResolutionTitle}">
                <ComboBoxItem Content="{Binding DataContext.AllText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="all" /><ComboBoxItem Content="≥720p" Tag="hd720" /><ComboBoxItem Content="≥1080p" Tag="fullHD" /><ComboBoxItem Content="≥4K" Tag="uhd4K" />
              </ComboBox>
              <TextBlock Text="{Binding DurationTitle}" VerticalAlignment="Center" Margin="15,0,6,0" />
              <ComboBox SelectedValue="{Binding Duration}" SelectedValuePath="Tag" Width="120" AutomationProperties.Name="{Binding DurationTitle}">
                <ComboBoxItem Content="{Binding DataContext.AllText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="all" /><ComboBoxItem Content="{Binding DataContext.UnderMinuteText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="underMinute" /><ComboBoxItem Content="{Binding DataContext.OneToFiveText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="oneToFive" /><ComboBoxItem Content="{Binding DataContext.FiveToTwentyText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="fiveToTwenty" /><ComboBoxItem Content="{Binding DataContext.OverTwentyText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="overTwenty" />
              </ComboBox>
              <TextBlock Text="{Binding ProjectTitle}" VerticalAlignment="Center" Margin="15,0,6,0" />
              <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding CurrentProject}" DisplayMemberPath="Name" Width="180" AutomationProperties.Name="{Binding ProjectTitle}" />
              <Button Content="{Binding ProjectAllText}" Command="{Binding ClearProjectCommand}" />
            </WrapPanel>
            <WrapPanel Margin="0,8,0,0">
              <TextBox Text="{Binding YearFrom, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding YearFromText}" Width="100" AutomationProperties.Name="{Binding YearFromText}" />
              <TextBlock Text="–" VerticalAlignment="Center" Margin="5,0" />
              <TextBox Text="{Binding YearTo, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding YearToText}" Width="100" AutomationProperties.Name="{Binding YearToText}" />
              <TextBlock Text="{Binding LicenseTitle}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <ComboBox SelectedValue="{Binding LicenseFilter}" SelectedValuePath="Tag" Width="210" AutomationProperties.Name="{Binding LicenseTitle}">
                <ComboBoxItem Content="{Binding DataContext.AllText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="all" /><ComboBoxItem Content="{Binding DataContext.LicenseKnownText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="knownOnly" /><ComboBoxItem Content="{Binding DataContext.LicenseOpenText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="openlyLicensed" /><ComboBoxItem Content="{Binding DataContext.LicensePublicDomainText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="publicDomain" />
              </ComboBox>
              <TextBlock Text="{Binding SortTitle}" VerticalAlignment="Center" Margin="15,0,6,0" />
              <ComboBox SelectedValue="{Binding Sort}" SelectedValuePath="Tag" Width="140" AutomationProperties.Name="{Binding SortTitle}">
                <ComboBoxItem Content="{Binding DataContext.SortRelevanceText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="relevance" /><ComboBoxItem Content="{Binding DataContext.SortNewestText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="newest" /><ComboBoxItem Content="{Binding DataContext.SortResolutionText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="resolution" /><ComboBoxItem Content="{Binding DataContext.SortDurationText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="duration" />
              </ComboBox>
              <TextBlock Text="{Binding RelevanceModeTitle}" VerticalAlignment="Center" Margin="15,0,6,0" />
              <ComboBox SelectedValue="{Binding RelevanceMode}" SelectedValuePath="Tag" Width="130" AutomationProperties.Name="{Binding RelevanceModeTitle}">
                <ComboBoxItem Content="{Binding DataContext.RelevancePreciseText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="precise" /><ComboBoxItem Content="{Binding DataContext.RelevanceBalancedText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="balanced" /><ComboBoxItem Content="{Binding DataContext.RelevanceBroadText, RelativeSource={RelativeSource AncestorType=Window}}" Tag="broad" />
              </ComboBox>
              <Button Content="{Binding ClearFiltersText}" Command="{Binding ClearFiltersCommand}" />
            </WrapPanel>
            <ItemsControl ItemsSource="{Binding Providers}" Margin="0,8,0,0">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate><StackPanel Orientation="Horizontal" Margin="0,0,16,0"><CheckBox Content="{Binding DisplayName}" IsChecked="{Binding Enabled}" ToolTip="{Binding Mode}" /><TextBlock Text="{Binding Status}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="5,0,0,0" /></StackPanel></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Margin="0,8,0,0" Visibility="{Binding HasResearchSearchScope, Converter={StaticResource BoolVisibility}}">
              <TextBlock Text="{Binding ResearchSourcesTitle}" VerticalAlignment="Center" Margin="0,0,10,0" />
              <ItemsControl ItemsSource="{Binding ResearchProviders}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate><CheckBox Content="{Binding DisplayName}" IsChecked="{Binding Enabled}" Margin="0,0,14,0" /></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </WrapPanel>
          </StackPanel>
          <StackPanel Grid.Row="3" Margin="0,4,0,8">
            <WrapPanel>
              <TextBlock Text="{Binding KeywordsTitle}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
              <CheckBox Content="{Binding SmartExpansionText}" IsChecked="{Binding SmartExpansionEnabled}" VerticalAlignment="Center" />
              <Button Content="{Binding RegenerateKeywordsText}" Command="{Binding RegenerateKeywordsCommand}" />
              <Button Content="{Binding AddKeywordText}" Command="{Binding AddSearchKeywordCommand}" />
              <Button Content="{Binding SearchLanguagesToggleText}" Command="{Binding ToggleSearchLanguagesCommand}" />
            </WrapPanel>
            <ItemsControl ItemsSource="{Binding SearchKeywordsView}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
